<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>滞納者管理データベース (モック)</title>
    <!-- Tailwind CSS (CDN) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        body { font-family: 'Segoe UI', Meiryo, sans-serif; }
        .bg-status-red { background-color: #fee2e2; border-left: 6px solid #ef4444; }
        .bg-status-yellow { background-color: #fef3c7; border-left: 6px solid #f59e0b; }
        .bg-status-blue { background-color: #e0f2fe; border-left: 6px solid #0284c7; }
        .bg-status-purple { background-color: #f3e8ff; border-left: 6px solid #9333ea; }
    </style>
</head>
<body class="bg-gray-100 text-gray-800 min-h-screen flex flex-col">

    <!-- ヘッダー -->
    <header class="bg-slate-800 text-white px-6 py-4 flex justify-between items-center shadow-md">
        <div class="flex items-center space-x-3">
            <i data-lucide="database" class="w-7 h-7 text-sky-400"></i>
            <h1 class="text-xl font-bold tracking-wide">滞納者管理データベース System</h1>
            <span class="bg-sky-500/20 text-sky-300 text-xs px-2.5 py-1 rounded-full border border-sky-400/30">プロトタイプ v1.1</span>
        </div>
        <div class="flex items-center space-x-4 text-sm">
            <!-- ロール切り替え（デモ用） -->
            <div class="bg-slate-700 px-3 py-1.5 rounded-lg flex items-center space-x-2">
                <span class="text-gray-400 text-xs">操作モード:</span>
                <select id="roleSelector" onchange="switchRole()" class="bg-slate-800 text-white font-medium focus:outline-none cursor-pointer">
                    <option value="all">全体表示（営業・内勤共通）</option>
                    <option value="office">内勤モード（ワンクリック受電）</option>
                    <option value="sales">営業モード（SMS催促・閉栓判断）</option>
                </select>
            </div>
            <!-- AS自動同期デモボタン -->
            <button onclick="triggerAsSync()" class="bg-sky-600 hover:bg-sky-500 text-white px-3 py-1.5 rounded-lg flex items-center space-x-1.5 transition text-xs shadow">
                <i data-lucide="refresh-cw" class="w-3.5 h-3.5"></i>
                <span>AS基幹データ手動同期</span>
            </button>
        </div>
    </header>

    <!-- メインコンテンツ -->
    <main class="flex-1 p-6 max-w-7xl mx-auto w-full space-y-6">

        <!-- ダッシュボード・ステータス集計 -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
            <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-200 flex items-center justify-between">
                <div>
                    <p class="text-xs font-semibold text-gray-500 uppercase">未対応・督促中 (要催促/閉栓)</p>
                    <h3 id="count-red" class="text-2xl font-bold text-red-600">0 件</h3>
                </div>
                <div class="p-3 bg-red-100 rounded-lg text-red-600"><i data-lucide="alert-triangle"></i></div>
            </div>
            <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-200 flex items-center justify-between">
                <div>
                    <p class="text-xs font-semibold text-gray-500 uppercase">口頭入金完了 (閉栓ストップ)</p>
                    <h3 id="count-yellow" class="text-2xl font-bold text-amber-600">0 件</h3>
                </div>
                <div class="p-3 bg-amber-100 rounded-lg text-amber-600"><i data-lucide="phone-call"></i></div>
            </div>
            <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-200 flex items-center justify-between">
                <div>
                    <p class="text-xs font-semibold text-gray-500 uppercase">一部入金 (要金額確認)</p>
                    <h3 id="count-purple" class="text-2xl font-bold text-purple-600">0 件</h3>
                </div>
                <div class="p-3 bg-purple-100 rounded-lg text-purple-600"><i data-lucide="calculator"></i></div>
            </div>
            <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-200 flex items-center justify-between">
                <div>
                    <p class="text-xs font-semibold text-gray-500 uppercase">AS確定入金完了 (消込済)</p>
                    <h3 id="count-blue" class="text-2xl font-bold text-sky-600">0 件</h3>
                </div>
                <div class="p-3 bg-sky-100 rounded-lg text-sky-600"><i data-lucide="check-circle-2"></i></div>
            </div>
        </div>

        <!-- リアルタイム通知ログ -->
        <div id="notificationBanner" class="hidden bg-emerald-50 border border-emerald-200 text-emerald-800 px-4 py-3 rounded-xl text-sm flex items-center justify-between shadow-sm animate-fade-in">
            <div class="flex items-center space-x-2">
                <i data-lucide="bell" class="w-4 h-4 text-emerald-600"></i>
                <span id="notificationText" class="font-medium"></span>
            </div>
            <span class="text-xs text-emerald-600 font-mono">リアルタイム更新</span>
        </div>

        <!-- フィルター & 操作バー -->
        <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-200 flex flex-wrap gap-4 items-center justify-between">
            <div class="flex items-center space-x-3 flex-1 min-w-[280px]">
                <div class="relative w-full">
                    <i data-lucide="search" class="w-4 h-4 absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400"></i>
                    <input type="text" id="searchInput" oninput="renderTable()" placeholder="顧客名、住所、電話番号、顧客IDで検索..." class="w-full pl-9 pr-4 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-sky-500 focus:outline-none">
                </div>
            </div>
            <div class="flex items-center space-x-2">
                <select id="statusFilter" onchange="renderTable()" class="border border-gray-300 text-sm rounded-lg px-3 py-2 focus:ring-2 focus:ring-sky-500 focus:outline-none">
                    <option value="all">全ステータス表示</option>
                    <option value="未対応・督促中">未対応・督促中（赤）</option>
                    <option value="口頭入金完了">口頭入金完了（黄）</option>
                    <option value="一部入金">一部入金（紫）</option>
                    <option value="AS確定入金完了">AS確定入金完了（青）</option>
                </select>
                <!-- SMS一括送信ボタン -->
                <button onclick="openSmsModal(null)" class="bg-indigo-600 hover:bg-indigo-700 text-white text-sm px-4 py-2 rounded-lg font-medium flex items-center space-x-1.5 transition shadow">
                    <i data-lucide="message-square" class="w-4 h-4"></i>
                    <span>一括SMS送信（ガード機能付）</span>
                </button>
            </div>
        </div>

        <!-- 一覧テーブル -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-slate-50 border-b border-gray-200 text-xs font-bold text-gray-600 uppercase tracking-wider">
                            <th class="p-4 w-10 text-center"><input type="checkbox" id="selectAll" onclick="toggleSelectAll()"></th>
                            <th class="p-4">ステータス</th>
                            <th class="p-4">顧客情報・住所</th>
                            <th class="p-4">請求情報</th>
                            <th class="p-4">担当営業</th>
                            <th class="p-4">内勤ワンアクション（受電）</th>
                            <th class="p-4 text-center">SMS催促ガード</th>
                            <th class="p-4 text-right">詳細・履歴</th>
                        </tr>
                    </thead>
                    <tbody id="customerTableBody" class="divide-y divide-gray-200 text-sm">
                        <!-- JavaScriptで動的生成 -->
                    </tbody>
                </table>
            </div>
        </div>
    </main>

    <!-- モーダル: SMS送信 -->
    <div id="smsModal" class="fixed inset-0 bg-black/50 hidden items-center justify-center p-4 z-50">
        <div class="bg-white rounded-xl max-w-lg w-full p-6 shadow-xl space-y-4">
            <div class="flex justify-between items-center border-b pb-3">
                <h3 class="text-lg font-bold text-gray-800 flex items-center space-x-2">
                    <i data-lucide="send" class="w-5 h-5 text-indigo-600"></i>
                    <span>SMS催促発信（誤発信自動ガード機能）</span>
                </h3>
                <button onclick="closeSmsModal()" class="text-gray-400 hover:text-gray-600"><i data-lucide="x"></i></button>
            </div>
            
            <div id="smsTargetList" class="text-xs bg-slate-50 p-3 rounded-lg border space-y-1">
                <!-- 送信対象顧客一覧 -->
            </div>

            <div>
                <label class="block text-xs font-semibold text-gray-600 mb-1">テンプレート選択</label>
                <select id="smsTemplate" onchange="updateSmsPreview()" class="w-full border rounded-lg p-2 text-sm">
                    <option value="1">【標準督促】ガス代金お支払い期日のご案内</option>
                    <option value="2">【最終告知】閉栓予告とお支払いのお願い</option>
                </select>
            </div>

            <div>
                <label class="block text-xs font-semibold text-gray-600 mb-1">本文プレビュー</label>
                <textarea id="smsPreview" rows="4" readonly class="w-full border rounded-lg p-2 text-xs bg-gray-50 text-gray-700 font-mono"></textarea>
            </div>

            <div id="smsGuardWarning" class="hidden bg-red-50 border border-red-200 p-3 rounded-lg flex items-start space-x-2 text-xs text-red-700">
                <i data-lucide="shield-alert" class="w-5 h-5 text-red-500 shrink-0"></i>
                <span id="smsGuardText"></span>
            </div>

            <div class="flex justify-end space-x-3 pt-3 border-t">
                <button onclick="closeSmsModal()" class="px-4 py-2 border rounded-lg text-sm font-medium hover:bg-gray-50">キャンセル</button>
                <button id="sendSmsBtn" onclick="executeSmsSend()" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg text-sm font-medium shadow">SMSを送信する</button>
            </div>
        </div>
    </div>

    <!-- JavaScript ロジック -->
    <script>
        // サンプル顧客データ（名前・住所を明確なダミー表現に変更）
        let customers = [
            { id: "C-0001", name: "●● 太郎", address: "××県××市●●町 1-2-3", phone: "090-0000-1111", amount: 12800, month: "2026年9月分", sales: "営業担当A", status: "未対応・督促中", history: ["10/01 請求書再送付"] },
            { id: "C-0002", name: "●● 花子", address: "××県××市▲▲ 4-5-6", phone: "080-0000-2222", amount: 8500, month: "2026年9月分", sales: "営業担当B", status: "未対応・督促中", history: ["09/28 電話催促連絡実施"] },
            { id: "C-0003", name: "×× 一郎", address: "××県××市■■ 7-8-9", phone: "090-0000-3333", amount: 15400, month: "2026年9月分", sales: "営業担当A", status: "口頭入金完了", history: ["10/09 10:15 内勤受電（本日振込完了との口頭申告あり）"] },
            { id: "C-0004", name: "▲▲ 健二", address: "××県××市●●町 9-8-7", phone: "090-0000-4444", amount: 21000, month: "2026年8月・9月分", sales: "営業担当C", status: "一部入金", partialAmount: 10000, history: ["10/08 8月分10,000円のみ振込確認"] },
            { id: "C-0005", name: "■■ 美咲", address: "××県××市▲▲ 6-5-4", phone: "080-0000-5555", amount: 9200, month: "2026年9月分", sales: "営業担当B", status: "AS確定入金完了", history: ["10/09 09:00 AS自動連動にて全額消込完了"] }
        ];

        let selectedSmsTarget = null;

        // 初期化
        document.addEventListener("DOMContentLoaded", () => {
            renderTable();
            lucide.createIcons();
        });

        // テーブル描画
        function renderTable() {
            const tbody = document.getElementById("customerTableBody");
            const search = document.getElementById("searchInput").value.toLowerCase();
            const filter = document.getElementById("statusFilter").value;
            tbody.innerHTML = "";

            let counts = { red: 0, yellow: 0, purple: 0, blue: 0 };

            customers.forEach((cust) => {
                // カウント更新
                if (cust.status === "未対応・督促中") counts.red++;
                if (cust.status === "口頭入金完了") counts.yellow++;
                if (cust.status === "一部入金") counts.purple++;
                if (cust.status === "AS確定入金完了") counts.blue++;

                // フィルタリング
                if (filter !== "all" && cust.status !== filter) return;
                if (search && 
                    !cust.name.toLowerCase().includes(search) && 
                    !cust.address.toLowerCase().includes(search) && 
                    !cust.phone.includes(search) && 
                    !cust.id.toLowerCase().includes(search)) return;

                // 行クラス判定
                let bgClass = "";
                let badgeClass = "";
                if (cust.status === "未対応・督促中") {
                    bgClass = "bg-status-red";
                    badgeClass = "bg-red-100 text-red-700 border-red-300";
                } else if (cust.status === "口頭入金完了") {
                    bgClass = "bg-status-yellow";
                    badgeClass = "bg-amber-100 text-amber-800 border-amber-300";
                } else if (cust.status === "一部入金") {
                    bgClass = "bg-status-purple";
                    badgeClass = "bg-purple-100 text-purple-800 border-purple-300";
                } else if (cust.status === "AS確定入金完了") {
                    bgClass = "bg-status-blue";
                    badgeClass = "bg-sky-100 text-sky-800 border-sky-300";
                }

                const tr = document.createElement("tr");
                tr.className = `${bgClass} transition hover:opacity-90`;

                // ガード状態チェック
                const isGuarded = cust.status === "口頭入金完了" || cust.status === "AS確定入金完了";

                tr.innerHTML = `
                    <td class="p-4 text-center"><input type="checkbox" class="customer-checkbox" value="${cust.id}"></td>
                    <td class="p-4 font-semibold">
                        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold border ${badgeClass}">
                            ${cust.status}
                        </span>
                    </td>
                    <td class="p-4">
                        <div class="font-bold text-gray-900">${cust.name} 様</div>
                        <div class="text-xs text-gray-600">${cust.address}</div>
                        <div class="text-xs text-gray-400">ID: ${cust.id} | TEL: ${cust.phone}</div>
                    </td>
                    <td class="p-4">
                        <div class="font-bold text-gray-900">¥${cust.amount.toLocaleString()}</div>
                        <div class="text-xs text-gray-500">${cust.month} ${cust.partialAmount ? `<br><span class="text-purple-600 font-medium">(一部既納: ¥${cust.partialAmount.toLocaleString()})</span>` : ''}</div>
                    </td>
                    <td class="p-4 text-gray-700 font-medium">${cust.sales}</td>
                    <td class="p-4">
                        ${cust.status === "未対応・督促中" ? `
                            <button onclick="markOralPayment('${cust.id}')" class="bg-amber-500 hover:bg-amber-600 text-white text-xs px-3 py-1.5 rounded-lg font-bold flex items-center space-x-1 shadow">
                                <i data-lucide="phone-incoming" class="w-3.5 h-3.5"></i>
                                <span>口頭受電完了チェック</span>
                            </button>
                        ` : cust.status === "口頭入金完了" ? `
                            <span class="text-xs text-amber-700 font-bold flex items-center space-x-1">
                                <i data-lucide="check" class="w-4 h-4"></i>
                                <span>閉栓ストップ済</span>
                            </span>
                        ` : `
                            <span class="text-xs text-gray-400">対応不要</span>
                        `}
                    </td>
                    <td class="p-4 text-center">
                        ${isGuarded ? `
                            <span class="inline-flex items-center space-x-1 bg-emerald-100 text-emerald-800 text-xs px-2.5 py-1 rounded-md font-semibold border border-emerald-300">
                                <i data-lucide="shield-check" class="w-3.5 h-3.5 text-emerald-600"></i>
                                <span>送信自動ブロック</span>
                            </span>
                        ` : `
                            <button onclick="openSmsModal('${cust.id}')" class="bg-indigo-50 hover:bg-indigo-100 text-indigo-700 border border-indigo-200 text-xs px-2.5 py-1 rounded-md font-medium flex items-center space-x-1 mx-auto">
                                <i data-lucide="send" class="w-3 h-3"></i>
                                <span>SMS準備</span>
                            </button>
                        `}
                    </td>
                    <td class="p-4 text-right">
                        <button onclick="showHistory('${cust.id}')" class="text-gray-500 hover:text-gray-800 text-xs underline">
                            履歴 (${cust.history.length})
                        </button>
                    </td>
                `;
                tbody.appendChild(tr);
            });

            // 集計数反映
            document.getElementById("count-red").innerText = `${counts.red} 件`;
            document.getElementById("count-yellow").innerText = `${counts.yellow} 件`;
            document.getElementById("count-purple").innerText = `${counts.purple} 件`;
            document.getElementById("count-blue").innerText = `${counts.blue} 件`;

            lucide.createIcons();
        }

        // 内勤ワンアクション: 口頭入金チェック
        function markOralPayment(id) {
            const cust = customers.find(c => c.id === id);
            if (cust) {
                cust.status = "口頭入金完了";
                const now = new Date().toLocaleTimeString('ja-JP', { hour: '2-digit', minute: '2-digit' });
                cust.history.unshift(`${now} 内勤電話受付（口頭入金完了を更新・即時閉栓中止）`);
                
                showNotification(`【リアルタイム更新】${cust.name} 様の受電チェックが完了しました。担当（${cust.sales}）の画面へ即時反映され、誤催促・誤閉栓がブロックされました。`);
                renderTable();
            }
        }

        // AS基幹システム自動同期（デモシミュレーション）
        function triggerAsSync() {
            // 未対応または口頭受電の最初の顧客をAS確定に自動昇格
            const target = customers.find(c => c.status === "口頭入金完了") || customers.find(c => c.status === "未対応・督促中");
            if (target) {
                target.status = "AS確定入金完了";
                const now = new Date().toLocaleTimeString('ja-JP', { hour: '2-digit', minute: '2-digit' });
                target.history.unshift(`${now} AS基幹連携（入金データ自動照合・自動消込完了）`);
                
                showNotification(`【AS自動連携】基幹システム(AS)より入金データを受信しました：${target.name} 様（¥${target.amount.toLocaleString()}）を自動消込・確定しました。`);
                renderTable();
            } else {
                alert("同期対象の未消込データはありません。");
            }
        }

        // 通知バー表示
        function showNotification(msg) {
            const banner = document.getElementById("notificationBanner");
            const text = document.getElementById("notificationText");
            text.innerText = msg;
            banner.classList.remove("hidden");
        }

        // SMSモーダル制御
        function openSmsModal(singleId) {
            const modal = document.getElementById("smsModal");
            const targetListDiv = document.getElementById("smsTargetList");
            const warningDiv = document.getElementById("smsGuardWarning");
            const sendBtn = document.getElementById("sendSmsBtn");

            let targets = [];
            if (singleId) {
                targets = customers.filter(c => c.id === singleId);
            } else {
                const checkedBoxes = document.querySelectorAll(".customer-checkbox:checked");
                const ids = Array.from(checkedBoxes).map(cb => cb.value);
                targets = customers.filter(c => ids.includes(c.id));
            }

            if (targets.length === 0) {
                alert("SMS送信対象の顧客を選択してください。");
                return;
            }

            // チェック＆ガードロジック
            const blockedTargets = targets.filter(t => t.status === "口頭入金完了" || t.status === "AS確定入金完了");
            const validTargets = targets.filter(t => t.status !== "口頭入金完了" && t.status !== "AS確定入金完了");

            targetListDiv.innerHTML = `<strong>対象顧客:</strong> ${targets.map(t => `${t.name} 様 (${t.status})`).join(", ")}`;

            if (blockedTargets.length > 0) {
                warningDiv.classList.remove("hidden");
                document.getElementById("smsGuardText").innerHTML = `
                    <strong>誤催促ガード発動:</strong> 選択された顧客のうち [${blockedTargets.map(b => b.name + ' 様').join(", ")}] は既に入金受電済みまたはAS確定データが存在します。システムの安全機能により、これらの顧客へのSMS発信は自動除外・ブロックされます。
                `;
            } else {
                warningDiv.classList.add("hidden");
            }

            if (validTargets.length === 0) {
                sendBtn.disabled = true;
                sendBtn.classList.add("opacity-50", "cursor-not-allowed");
            } else {
                sendBtn.disabled = false;
                sendBtn.classList.remove("opacity-50", "cursor-not-allowed");
            }

            updateSmsPreview();
            modal.classList.remove("hidden");
            modal.classList.add("flex");
        }

        function closeSmsModal() {
            document.getElementById("smsModal").classList.add("hidden");
            document.getElementById("smsModal").classList.remove("flex");
        }

        function updateSmsPreview() {
            const templateId = document.getElementById("smsTemplate").value;
            const preview = document.getElementById("smsPreview");
            if (templateId === "1") {
                preview.value = "【〇〇ガス】いつもご利用ありがとうございます。9月分ガス代金のお支払いが確認できておりません。恐れ入りますが本URLよりお支払い手続をお願いいたします。";
            } else {
                preview.value = "【重要・〇〇ガス】ガス代金未払いによる供給停止（閉栓）に関する最終のご案内です。本日中にご連絡またはお振込が確認できない場合、閉栓作業へ移行いたします。";
            }
        }

        function executeSmsSend() {
            alert("ガード機能により入金済み顧客を除外した上で、安全に催促SMSを一括送信しました（送信ログ保持）。");
            closeSmsModal();
        }

        function showHistory(id) {
            const cust = customers.find(c => c.id === id);
            alert(`【対応履歴ログ - ${cust.name} 様】\n住所: ${cust.address}\n\n` + cust.history.join("\n"));
        }

        function toggleSelectAll() {
            const selectAll = document.getElementById("selectAll").checked;
            document.querySelectorAll(".customer-checkbox").forEach(cb => cb.checked = selectAll);
        }

        function switchRole() {
            renderTable();
        }
    </script>
</body>
